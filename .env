# Keycloak http://localhost:8880: Client > Credentials > Client Secret
# ist angepasst auf client-secret des realms javascript, javascript-client
CLIENT_SECRET=Gd2wFCWbu8MktGDoNDw9Cw5M41wm7DmhPeRMFr9oTexOTm7hizET8VnofCNF7KweaS4rTx3XuCr7hvJ0cv1HkX

# Drizzle mit Bun: **OHNE** TLS, sonst Zertifikat-Fehler ?!
# DATABASE_URL="postgresql://web_shop:p@localhost/web_shop"
# URL von python project übernommen.
DATABASE_URL="postgresql+psycopg://web_shop:web_shop@localhost:5432/web_shop?connection_limit=10"

#DATABASE_URL_ADMIN="postgresql://postgres:p@localhost/web_shop?schema=web_shop&connection_limit=10"

# Keycloak realm issuer URL as it appears in the access token's "iss" claim.
KEYCLOAK_ISSUER=http://localhost:8080/realms/javascript

# Configure an Audience mapper in Keycloak so the access token includes this value in "aud".
KEYCLOAK_AUDIENCE=web-shop-api
