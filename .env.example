# Keycloak realm issuer URL as it appears in the access token's "iss" claim.
KEYCLOAK_ISSUER=http://localhost:8080/realms/replace-with-your-realm

# Configure an Audience mapper in Keycloak so the access token includes this value in "aud".
KEYCLOAK_AUDIENCE=web-shop-api

# Optional override when the API cannot reach the JWKS endpoint at the issuer URL.
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/replace-with-your-realm/protocol/openid-connect/certs
